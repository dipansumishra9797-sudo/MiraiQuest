# ==============================================================================
# MiraiQuest Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# Required for: AI Study Buddy, Hinglish technical explanations,
# AI quiz question generation, and PDF course material to MCQ generation.
# Get a key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 2. Application Host & Server Configuration
# APP_URL: The base URL where the MiraiQuest portal is hosted.
# PORT: Local server listening port (default: 3000).
# ------------------------------------------------------------------------------
APP_URL="http://localhost:3000"
PORT="3000"

# ------------------------------------------------------------------------------
# 3. Code Execution Engine (Judge0 CE / Piston)
# Used by /api/run to execute Python 3, JavaScript (Node), C, C++, and Java.
# JUDGE0_URL: Public or self-hosted Judge0 CE instance (default: https://ce.judge0.com).
# JUDGE0_KEY: RapidAPI or Judge0 authentication key (leave empty if using free CE).
# PISTON_URL: Optional secondary fallback execution engine (e.g., https://emkc.org/api/v2/piston).
# ------------------------------------------------------------------------------
JUDGE0_URL="https://ce.judge0.com"
JUDGE0_KEY=""
PISTON_URL=""

# ------------------------------------------------------------------------------
# 4. Web Push Notification Keys (VAPID)
# Used to dispatch real-time browser push notifications to student devices.
# Generate a new pair with: npx web-push generate-vapid-keys
# ------------------------------------------------------------------------------
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjZJuBkr3qBUYIHBQFLXYEZ53vKQY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@msot.edu"

# ------------------------------------------------------------------------------
# 5. Security & Authentication (JWT Secret)
# Used to cryptographically sign and verify login OTP authentication session tokens.
# Must be a strong, random 32+ character secret in production.
# ------------------------------------------------------------------------------
JWT_SECRET="miraiquest_super_secret_jwt_key_2026_collegiate_gamified"

# ------------------------------------------------------------------------------
# 6. Database Storage Path
# Path to local SQLite or file database storage for persistent audit logs,
# anti-cheat incident records, and verifiable XP ledger entries.
# ------------------------------------------------------------------------------
DATABASE_PATH="./data/miraiquest.db"
